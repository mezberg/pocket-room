# Copy to .env (never committed) and fill in. Run `npm run check:openai` to see which models your key can use.
OPENAI_API_KEY=

# Pick from the check's list. Decisions runs on gpt-6-luna per OpenAI's beta notes; verify with the check.
OPENAI_MODEL_TEXT=
OPENAI_MODEL_DECISIONS=gpt-6-luna
OPENAI_MODEL_IMAGE=
OPENAI_MODEL_REALTIME=

# Lane B, only if the hackathon allows a non-OpenAI image-to-3D service.
MESHY_API_KEY=

PORT=8790
